# Frontend (copy relevant value to frontend/.env.local)
VITE_API_BASE_URL=http://localhost:8000
# Experimental feature; validation did not support enabling it by default.
VITE_ENABLE_TASTE_QUIZ=false

# Backend
ALLOWED_ORIGINS=http://localhost:5173
# Optional; defaults to data/artifacts/weighted-als-hybrid-v1/weighted_als_hybrid.npz
# MODEL_ARTIFACT_PATH=/absolute/path/to/weighted_als_hybrid.npz
MINIMUM_MAPPED_RATINGS=5
# Validation selected 0. Keep disabled until a pairwise-aware model improves ranking metrics.
PAIRWISE_PREFERENCE_WEIGHT=0
