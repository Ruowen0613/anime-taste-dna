# Frontend (copy relevant value to frontend/.env.local)
VITE_API_BASE_URL=http://localhost:8000

# Backend
ALLOWED_ORIGINS=http://localhost:5173
# Optional; defaults to data/artifacts/matrix-factorization-v1/matrix_factorization.npz
# MODEL_ARTIFACT_PATH=/absolute/path/to/matrix_factorization.npz
MINIMUM_MAPPED_RATINGS=5
# Validation selected 0. Keep disabled until a pairwise-aware model improves ranking metrics.
PAIRWISE_PREFERENCE_WEIGHT=0
